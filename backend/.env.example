PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/gulag_system
JWT_SECRET=troque-por-um-segredo-forte
NODE_ENV=development
# true apenas se o Postgres exigir SSL (no Railway interno costuma ser false)
DATABASE_SSL=false
# Token usado por um bot externo para confirmar presenca pelo telefone
INTEGRATION_TOKEN=
# Fotos dos jogadores. Sem estas variaveis, o upload cai para o disco local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Aviso de confirmacao por e-mail. Sem nenhuma destas variaveis o aviso nao e
# enviado (o resto do sistema funciona igual).
#
# Caminho 1 (recomendado em nuvem): API do Brevo, por HTTPS. Hospedagem costuma
# bloquear as portas de SMTP para conter spam — no Railway o SMTP da timeout.
# Exige o MAIL_FROM validado como remetente no painel do Brevo.
BREVO_API_KEY=
# Caminho 2: SMTP direto (funciona local). Gmail exige senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Obrigatorio com o Brevo; no SMTP, sem isso usa o SMTP_USER
MAIL_FROM=
# Endereco publico do sistema, usado no botao do e-mail.
# Sem isso, usa o endereco pelo qual o admin lancou a ATA.
APP_URL=
