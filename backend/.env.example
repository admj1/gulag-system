PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/gulag_system
JWT_SECRET=troque-por-um-segredo-forte
NODE_ENV=development
# true apenas se o Postgres exigir SSL (no Railway interno costuma ser false)
DATABASE_SSL=false
# Token usado por um bot externo para confirmar presenca pelo telefone
INTEGRATION_TOKEN=
# Fotos dos jogadores. Sem estas variaveis, o upload cai para o disco local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
